# Tailscale app settings (KEY=VALUE, no spaces around '=')
# TS_ACCEPT_DNS=1 lets tailscaled rewrite the NAS's /etc/resolv.conf (MagicDNS on the NAS itself); off is safer.
# Applied with 'tailscale set' when you save, and with 'tailscale up' when you log in.
TS_HOSTNAME=
TS_ACCEPT_ROUTES=0
TS_ADVERTISE_ROUTES=
TS_ADVERTISE_EXIT_NODE=0
TS_ACCEPT_DNS=0
TS_SSH=0
# Extra flags passed verbatim to 'tailscale up' at login (advanced)
TS_EXTRA_UP_ARGS=
# Extra flags passed verbatim to 'tailscaled' (advanced), e.g. --port=41641
TS_EXTRA_DAEMON_ARGS=
# Update channel: stable or unstable
TS_CHANNEL=stable
# Update notifications via the My Cloud alert system (bell icon + alert e-mail):
# off | daily | weekly | monthly. A new Tailscale security bulletin always alerts at once.
TS_NOTIFY=monthly
# Install new Tailscale releases automatically (the background check runs every 6 hours): 0 or 1
TS_AUTO_UPDATE=0
# Publish the My Cloud dashboard on your tailnet via 'tailscale serve' (0 or 1).
# Needed to reach the dashboard remotely: WD's web server refuses Tailscale addresses directly.
TS_SERVE_DASHBOARD=0
