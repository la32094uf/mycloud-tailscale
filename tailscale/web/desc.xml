  <en-US><![CDATA[<p>Tailscale VPN for My Cloud OS5: log in with an auth key, change settings and update the Tailscale binaries in place, right here.</p>
<div id="ts-embed"></div>
<script>
/* The dashboard inserts this description with jQuery.html(), so scripts run.
   Load the settings page inline and hide the redundant "Configuration URL" row. */
(function () {
  if (!window.jQuery || !document.getElementById('ts-embed')) return;
  setTimeout(function () { jQuery('#apps_config_button').closest('tr').hide(); }, 0);
  jQuery('#ts-embed').load('/apps/tailscale/index.php');
})();
</script>]]></en-US>
